{
  "name": "pip-expenses-tracker",
  "version": "1.0.16",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "test": "jest",
    "typecheck": "NODE_OPTIONS=\"--max-old-space-size=8192\" tsc --noEmit",
    "audit:type": "node tools/typeAudit/audit.js",
    "audit:contrast": "node tools/contrastAudit/audit.js",
    "limits": "sucrase-node tools/limitDashboard/report.ts",
    "limits:watch": "sucrase-node tools/limitDashboard/report.ts --watch",
    "limits:web": "sucrase-node tools/limitDashboard/report.ts --web"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|react-native-purchases|@revenuecat|react-native-reanimated|react-native-gesture-handler|react-native-worklets))"
    ]
  },
  "overrides": {
    "tslib": "^2.6.2"
  },
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@sentry/react-native": "~7.2.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "jest-expo": "~54.0.17",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.22.1",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^10.9.1",
    "react-native-purchases-ui": "^10.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@types/jest": "~29.5.14",
    "@types/node": "^25.9.1",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
