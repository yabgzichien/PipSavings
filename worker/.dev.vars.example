# Copy to .dev.vars for local wrangler. Never commit real values.
REVENUECAT_SECRET_KEY=sk_replace_me
REVENUECAT_PROJECT_ID=proj_replace_me
PRO_ENTITLEMENT_ID=pip_pro

# Local development only: with no provider keys set, /scan returns canned rows when this is "true".
# Never set it in production; without it a keyless worker answers 503 instead of inventing data.
ALLOW_MOCK_SCAN=true
